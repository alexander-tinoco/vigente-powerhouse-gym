# --- Núcleo ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Monterrey

# --- Datos ---
DATABASE_URL=postgresql://vigente:cambiar@db:5432/vigente
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=cambiar_en_produccion

# --- Reglas de negocio ---
DIAS_GRACIA_DEFAULT=3
DIAS_AVISO_PREVENCIMIENTO=7
DIAS_PARA_CANCELACION_AUTOMATICA=60
META_VISITAS_SEMANAL_DEFAULT=3

# --- Biometría ---
BIOMETRIC_MATCH_THRESHOLD=0.42
ANTISPOOF_THRESHOLD=0.75
EDGE_SERVICE_URL=https://edge.local:8100
EDGE_CACHE_TTL_SECONDS=300
BIOMETRIC_TEMPLATE_ENCRYPTION_KEY=
QR_TOKEN_TTL_SECONDS=60

# --- Pagos ---
PAYMENT_PROVIDER=mercadopago
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Clientes ---
VITE_API_BASE_URL=http://localhost:8000
